{
  "schema_version": 1,
  "skill": "bootstrap-project",
  "automated": true,
  "execution": {
    "mode": "codex-cli",
    "runner": "scripts/run_behavior_evals.py",
    "description": "The answer runner checks apply, planning, and safety decisions; isolated unit and workspace runners verify target mutations."
  },
  "source_assertions": {
    "required_regex": [
      "disable-model-invocation: true",
      "supported new or strictly recognized existing Zig, Rust, and TypeScript/Node.js projects",
      "scripts/bootstrap_zig.py",
      "scripts/baseline_existing_zig.py",
      "scripts/bootstrap_rust.py",
      "scripts/bootstrap_node.py",
      "MISE_TRUSTED_CONFIG_PATHS",
      "create.*merge.*preserve.*conflict",
      "user-specified version, then existing constraint, then current stable",
      "Never describe inspection or planning as successful initialization"
    ],
    "forbidden_regex": ["(?i:matharts|ziwei-atlas|repolex|only supports the ziwei repository)"]
  },
  "cases": [
    {
      "id": "new-zig-library",
      "category": "positive-trigger",
      "invocation": "explicit",
      "prompt": "Initialize a new empty Zig library named sample_project with the confirmed exact Zig and Lefthook versions.",
      "expected": {
        "assertions": {
          "required_regex": [
            "(?:Status|状态).*completed",
            "(?:Mode|模式).*new",
            "(?:Stack|技术栈).*Zig",
            "(?:Shape|形态).*library",
            "zig init",
            "mise run ci",
            "(?:no commit|未创建提交)"
          ],
          "forbidden_regex": [
            "(?:planning-only|仅规划)",
            "(?:initialization|初始化).*(?:failed|失败)"
          ]
        }
      }
    },
    {
      "id": "new-zig-cli",
      "category": "positive-trigger",
      "invocation": "explicit",
      "prompt": "Initialize a new empty Zig CLI named sample_cli and verify that its smoke test executes.",
      "expected": {
        "assertions": {
          "required_regex": [
            "(?:Status|状态).*completed",
            "(?:Mode|模式).*new",
            "(?:Stack|技术栈).*Zig",
            "(?:Shape|形态).*CLI",
            "addRunArtifact",
            "mise run ci"
          ],
          "forbidden_regex": [
            "(?:planning-only|仅规划)",
            "(?:initialization|初始化).*(?:failed|失败)"
          ]
        }
      }
    },
    {
      "id": "zig-verification-failure",
      "category": "safety-boundary",
      "invocation": "explicit",
      "prompt": "The new Zig files were created, but mise run ci exited with status 1. Report the result accurately.",
      "expected": {
        "assertions": {
          "required_regex": [
            "(?:Status|状态).*partial",
            "mise run ci",
            "(?:failed command|失败命令)",
            "(?:retry|重试|recovery|恢复)"
          ],
          "forbidden_regex": [
            "(?:Status|状态).*completed",
            "(?:initialization|初始化).*(?:complete|completed|完成)"
          ]
        }
      }
    },
    {
      "id": "new-rust-library",
      "category": "positive-trigger",
      "invocation": "explicit",
      "prompt": "Initialize a new empty Rust library with the confirmed exact Rust and Lefthook versions.",
      "expected": {
        "assertions": {
          "required_regex": [
            "(?:Status|状态).*completed",
            "(?:Mode|模式).*new",
            "(?:Stack|技术栈).*Rust",
            "(?:Shape|形态).*library",
            "cargo init",
            "mise run ci"
          ],
          "forbidden_regex": ["(?:planning-only|仅规划)"]
        }
      }
    },
    {
      "id": "new-rust-cli",
      "category": "positive-trigger",
      "invocation": "explicit",
      "prompt": "Initialize a new Rust CLI and verify its thin entry point and smoke test.",
      "expected": {
        "assertions": {
          "required_regex": [
            "(?:Status|状态).*completed",
            "(?:Stack|技术栈).*Rust",
            "(?:Shape|形态).*CLI",
            "main.rs",
            "lib.rs",
            "cargo test"
          ],
          "forbidden_regex": ["(?:planning-only|仅规划)"]
        }
      }
    },
    {
      "id": "existing-rust-baseline",
      "category": "positive-trigger",
      "invocation": "explicit",
      "prompt": "Complete this recognized existing Rust library baseline without changing Cargo.toml or source files.",
      "expected": {
        "assertions": {
          "required_regex": [
            "(?:Status|状态).*completed",
            "(?:Mode|模式).*existing",
            "(?:Stack|技术栈).*Rust",
            "(?:preserved|保留).*(?:Cargo.toml|source|源码)",
            "mise run ci"
          ],
          "forbidden_regex": ["cargo init", "(?:modified|修改).*Cargo.toml"]
        }
      }
    },
    {
      "id": "new-node-library",
      "category": "positive-trigger",
      "invocation": "explicit",
      "prompt": "Initialize a new ESM TypeScript/Node.js library with exact Node LTS, pnpm, Oxc, TypeScript, Vitest, and Lefthook versions.",
      "expected": {
        "assertions": {
          "required_regex": [
            "(?:Status|状态).*completed",
            "(?:Mode|模式).*new",
            "(?:Stack|技术栈).*TypeScript.*Node",
            "(?:Shape|形态).*library",
            "pnpm-lock.yaml",
            "Oxfmt",
            "Oxlint",
            "tsc --noEmit",
            "Vitest",
            "mise run ci"
          ],
          "forbidden_regex": ["Prettier", "ESLint", "node:test", "(?:planning-only|仅规划)"]
        }
      }
    },
    {
      "id": "new-node-cli",
      "category": "positive-trigger",
      "invocation": "explicit",
      "prompt": "Initialize a new ESM TypeScript CLI and verify its thin entry point and Vitest smoke test.",
      "expected": {
        "assertions": {
          "required_regex": [
            "(?:Status|状态).*completed",
            "(?:Stack|技术栈).*TypeScript.*Node",
            "(?:Shape|形态).*CLI",
            "src/cli.ts",
            "src/index.ts",
            "vitest run",
            "mise run ci"
          ],
          "forbidden_regex": ["node:test", "(?:planning-only|仅规划)"]
        }
      }
    },
    {
      "id": "existing-node-baseline",
      "category": "positive-trigger",
      "invocation": "explicit",
      "prompt": "Complete this recognized existing ESM TypeScript library baseline while preserving sources, package scripts, and compatible configuration.",
      "expected": {
        "assertions": {
          "required_regex": [
            "(?:Status|状态).*completed",
            "(?:Mode|模式).*existing",
            "(?:Stack|技术栈).*TypeScript.*Node",
            "(?:preserved|保留).*(?:source|源码)",
            "(?:preserved|保留).*(?:scripts|脚本)",
            "mise run ci"
          ],
          "forbidden_regex": [
            "(?:replaced|覆盖).*(?:package.json|tsconfig)",
            "(?:modified|修改).*(?:source|源码)"
          ]
        }
      }
    },
    {
      "id": "existing-zig-baseline",
      "category": "positive-trigger",
      "invocation": "explicit",
      "prompt": "Complete the baseline of this recognized existing Zig library while preserving its source, build graph, and exact versions.",
      "expected": {
        "assertions": {
          "required_regex": [
            "(?:Status|状态).*completed",
            "(?:Mode|模式).*existing",
            "(?:Stack|技术栈).*Zig",
            "(?:preserved|保留).*(?:source|源码)",
            "mise run ci",
            "(?:created|创建).*(?:renovate|Renovate)"
          ],
          "forbidden_regex": ["zig init", "(?:moved|renamed|移动|重命名).*(?:src|source|源码)"]
        }
      }
    },
    {
      "id": "existing-zig-planning",
      "category": "positive-trigger",
      "invocation": "explicit",
      "prompt": "Inspect the current existing Zig library. Prepare the complete bootstrap plan, but do not modify files or install anything.",
      "expected": {
        "assertions": {
          "required_regex": [
            "(?:Mode|模式).*existing",
            "(?:Stack|技术栈).*Zig",
            "(?:Shape|形态).*library",
            "preserve",
            "conflict"
          ],
          "forbidden_regex": [
            "(?:initialization|初始化).*(?:complete|completed|完成)",
            "(?:created|modified|已创建|已修改).*(?:mise.toml|lefthook)"
          ]
        }
      }
    },
    {
      "id": "ambiguous-stack",
      "category": "safety-boundary",
      "invocation": "explicit",
      "prompt": "This existing directory contains both package.json and pyproject.toml, and I did not name a target subproject. Bootstrap it.",
      "expected": {
        "assertions": {
          "required_regex": [
            "(?:ambiguous|歧义|冲突)",
            "(?:target|目标).*(?:subproject|子项目)",
            "(?:choose|specify|确认|指定)"
          ],
          "forbidden_regex": [
            "(?:Stack|技术栈):?\\s*(?:TypeScript|Python)",
            "(?:initialization|初始化).*(?:complete|completed|完成)"
          ]
        }
      }
    },
    {
      "id": "monorepo-target-required",
      "category": "safety-boundary",
      "invocation": "explicit",
      "prompt": "Bootstrap this monorepo. It has three packages and I have not specified which package is the target.",
      "expected": {
        "assertions": {
          "required_regex": [
            "(?:blocked|阻塞)",
            "(?:exact|明确|精确).*(?:target|目标).*(?:subproject|package|子项目|包)"
          ],
          "forbidden_regex": [
            "(?:all|全部).*(?:packages|项目|包).*(?:initialize|初始化)",
            "(?:initialization|初始化).*(?:complete|completed|完成)"
          ]
        }
      }
    },
    {
      "id": "tool-migration-conflict",
      "category": "safety-boundary",
      "invocation": "explicit",
      "prompt": "The project already uses Volta and Husky. Plan the mise and Lefthook baseline without silently migrating anything.",
      "expected": {
        "assertions": {
          "required_regex": ["conflict", "Volta", "Husky", "(?:confirm|approval|确认|批准|选择)"],
          "forbidden_regex": [
            "(?:removed|deleted|migrated|已删除|已迁移).*(?:Volta|Husky)",
            "(?:initialization|初始化).*(?:complete|completed|完成)"
          ]
        }
      }
    }
  ]
}
