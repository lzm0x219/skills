{
  "schema_version": 1,
  "skill": "dsa-design",
  "automated": true,
  "execution": {
    "mode": "codex-cli",
    "runner": "scripts/run_behavior_evals.py",
    "description": "运行器使用已认证的 Codex CLI 执行提示，并通过确定性的输出断言评分。"
  },
  "source_assertions": {
    "required_regex": [
      "先运行适用性门槛",
      "不存在实质性 DSA 选择",
      "只有用户明确要求编写或修改代码时才实施"
    ],
    "forbidden_regex": [
      "(?i:repolex|analysistarget|analysisoptions|analysisreport|languagestat|resolvedmode)"
    ]
  },
  "cases": [
    {
      "id": "prose-edit-no-trigger",
      "category": "out-of-scope",
      "invocation": "implicit",
      "prompt": "将设置页按钮文案从 \"Save\" 改为 \"Save changes\"。只返回替换文案，不修改文件。",
      "expected": {
        "assertions": {
          "required_regex": ["Save changes"],
          "forbidden_regex": [
            "(?:DSA|数据结构|算法|复杂度|data structure|algorithm|complexity)",
            "(?:数据结构|算法|data structure|algorithm).*(?:方案|option)"
          ]
        }
      }
    },
    {
      "id": "simple-crud-no-forced-dsa",
      "category": "applicability-gate",
      "invocation": "implicit",
      "prompt": "在既有内存用户列表中增加按唯一 ID 删除用户的方法。数据集很小，且没有新的性能或持久化要求。",
      "expected": {
        "assertions": {
          "required_regex": ["(?:保留|复用|既有|keep|reuse|existing).*(?:列表|list)"],
          "forbidden_regex": ["DSA\\s*(?:选择|choice)", "(?:方案|Option)\\s*[123]"]
        }
      }
    },
    {
      "id": "top-k-material-decision",
      "category": "positive-trigger",
      "invocation": "explicit",
      "prompt": "设计一个接口：从持续增长、规模数千万级的事件流中返回最近一小时得分最高的前 100 条记录。写入远多于读取，内存有明确上限。先给出方案，不替我作实质性权衡。",
      "expected": {
        "assertions": {
          "required_regex": [
            "Top\\s*-?\\s*(?:K|100)",
            "(?:精确|exact)",
            "(?:近似|approximate|Space-Saving|Count-Min)",
            "O\\(",
            "(?:内存|空间|memory|space).*(?:有界|上限|无界|bound|limit|unbounded)",
            "(?:I/O|IO|disk|database|external state)",
            "(?:维护|实现复杂度|操作|maintain|implementation complexity|operations)",
            "(?:建议|推荐|recommend|prefer).*(?:精确|近似|exact|approximate|Space-Saving|Count-Min)",
            "(?:当|如果|when|if).*(?:更好|优先|反超|切换|better|prefer|overtake|switch)",
            "(?:需要|请|need|please).*(?:决定|选择|decide|choose)|choose.*semantic"
          ],
          "forbidden_regex": [
            "```(?:bash|sh|zsh|python|ruby|javascript|typescript|java|kotlin|swift|go|rust|c|cpp|csharp|sql)(?:\\s|\\n)",
            "(?:直接|立即|directly|immediately).*(?:实施|发布|部署|implement|ship|deploy)"
          ]
        }
      }
    },
    {
      "id": "delegated-choice-no-pause",
      "category": "positive-trigger",
      "invocation": "explicit",
      "prompt": "设计一个查询：从数千万级事件流中返回最近一小时得分最高的前 100 条记录。在这些约束下选择最合适方案；内部数据结构和算法由你决定。先给出最终设计和验证计划，不给代码，也不要再要求我选择。",
      "expected": {
        "assertions": {
          "required_regex": [
            "(?:Space-Saving|Count-Min|ring bucket|min-?heap)",
            "O\\(",
            "(?:最终设计|建议|采用|使用|final design|recommend|adopt|use)",
            "(?:内存|空间|memory|space).*(?:有界|上限|bound|limit)",
            "(?:验证|verif)"
          ],
          "forbidden_regex": [
            "(?:需要|请|need|please)\\s+(?:你|you\\s+)?(?:决定|选择|decide|choose)",
            "(?:等待|wait).*(?:决定|选择|decision|choice)",
            "(?:方案|Option)\\s*[123]"
          ]
        }
      }
    }
  ]
}
