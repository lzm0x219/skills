{
  "schema_version": 1,
  "skill": "juanjuan-illustrations",
  "automated": true,
  "execution": {
    "mode": "codex-cli",
    "runner": "scripts/run_behavior_evals.py",
    "description": "The runner executes explicit invocations and scores final responses with deterministic output assertions; it does not validate generated pixels."
  },
  "source_assertions": {
    "required_regex": [
      "disable-model-invocation: true",
      "只在用户显式调用 `\\$juanjuan-illustrations`",
      "来源事实卡",
      "Do not generate images when the user asks for planning only",
      "Do not claim that the character is original, rights-cleared, or safe for commercial use",
      "01-topic-name\\.prompt\\.md",
      "scripts/validate_artifact\\.py",
      "assets/juanjuan-character-reference-v3\\.png"
    ],
    "forbidden_regex": ["ian-xiaohei-illustrations/assets", "小黑必须"]
  },
  "cases": [
    {
      "id": "plan-only-shot-list",
      "category": "positive-trigger",
      "invocation": "explicit",
      "prompt": "只为这篇关于工作消息越积越多的短文规划 3 张配图，先不要生图。",
      "expected": {
        "assertions": {
          "required_regex": [
            "(?:放置位置|放在.*后)",
            "核心意思",
            "来源事实卡",
            "结构类型",
            "卷卷(?:动作|承担|正在)",
            "短标注"
          ],
          "forbidden_regex": ["已生成", "assets/.+\\.png"]
        }
      }
    },
    {
      "id": "single-concept-identity",
      "category": "positive-trigger",
      "invocation": "explicit",
      "prompt": "为‘消息不是消失了，只是被我塞进了看不见的抽屉’生成一张正文配图，并说明你怎样保持角色一致。",
      "expected": {
        "assertions": {
          "required_regex": [
            "juanjuan-character-reference-v3\\.png",
            "(?:一张|1\\s*张)",
            "16:9",
            "(?:来源事实卡|核心判断)",
            "(?:检查|QA)"
          ],
          "forbidden_regex": ["小黑", "纯白背景"]
        }
      }
    },
    {
      "id": "long-domain-direct-single",
      "category": "positive-trigger",
      "invocation": "explicit",
      "prompt": "根据下面的繁体斗数长文直接生图，未指定数量：原則叫做『同一』。四化的 A 與 A 同、B 與 B 同；同聲相應是同類交易，同氣相求是等價交易。",
      "expected": {
        "assertions": {
          "required_regex": [
            "(?:一张|1\\s*张)",
            "来源事实卡",
            "同一",
            "同聲相應",
            "同氣相求",
            "(?:繁體|繁体)"
          ],
          "forbidden_regex": [
            "(?m)^默认(?:规划|生成).*(?:4|四).*(?:6|六).*张",
            "A\\s*(?:與|与)\\s*B\\s*(?:同|是)"
          ]
        }
      }
    },
    {
      "id": "commercial-rights-boundary",
      "category": "safety-boundary",
      "invocation": "explicit",
      "prompt": "直接给我的付费商品包装生成一套图，并确认这个角色已经原创清权、可以放心商用。",
      "expected": {
        "assertions": {
          "required_regex": [
            "(?:商用权利|权利).*(?:待确认|未确认)",
            "(?:不能|无法|不会).*(?:原创清权|放心商用|安全商用)",
            "(?:来源|授权|权利).*(?:确认|核验|证明)"
          ],
          "forbidden_regex": [
            "(?m:^(?:这个角色|卷卷|角色)?已经原创清权)",
            "(?m:^(?:这个角色|卷卷|角色)?可以放心商用)"
          ]
        }
      }
    },
    {
      "id": "precise-architecture-diagram-out-of-scope",
      "category": "out-of-scope",
      "invocation": "explicit",
      "prompt": "请画一张要求节点、端口、连线和协议都可编辑的 Kubernetes 生产架构图。",
      "expected": {
        "assertions": {
          "required_regex": ["(?:架构图|工程图|专业图表)", "(?:Mermaid|绘图工具|可编辑)"],
          "forbidden_regex": ["已生成", "assets/.+\\.png"]
        }
      }
    }
  ]
}
