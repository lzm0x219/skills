{
  "schema_version": 1,
  "skill": "zig",
  "automated": true,
  "execution": {
    "mode": "codex-cli",
    "runner": "scripts/run_behavior_evals.py",
    "description": "运行器通过已认证的 Codex CLI 执行提示词，并用确定性的输出断言评分。"
  },
  "source_assertions": {
    "required_regex": [
      "按以下优先级确定任务的目标 Zig 版本或支持范围",
      "区分版本下限、支持范围、当前执行编译器和格式化器版本",
      "用户与仓库均未提供版本时，查询 Zig 官网并采用当时的最新稳定版",
      "不得把 master/nightly 当作“最新版本”",
      "不得用其他版本的 Style Guide 覆盖目标版本规则",
      "`zig build --help` 也会加载构建图",
      "运行时安全与非法行为",
      "当请求与 Zig 源码、构建配置、工具链或诊断无关时",
      "读取\\[编码最佳实践与风格\\]",
      "读取\\[构建、依赖与版本迁移\\]",
      "读取\\[C 互操作边界\\]",
      "明确每次内存分配的所有者及释放方式",
      "将 `build.zig` 视为可执行的项目代码",
      "只有测试产物实际运行且通过后，才报告测试通过",
      "先建立可复现性能基线",
      "交叉编译成功不能证明目标运行时正确",
      "官方版本校验脚本",
      "工具链 smoke 脚本"
    ],
    "forbidden_regex": [
      "(?i:repolex|analysistarget|analysisoptions|analysisreport|languagestat|resolvedmode)"
    ]
  },
  "cases": [
    {
      "id": "out-of-scope-direct-answer",
      "category": "out-of-scope",
      "invocation": "implicit",
      "prompt": "将 README 第一行改为 \"Toolset\"。此任务与 Zig 源码、构建配置、工具链和诊断无关。",
      "expected": {
        "assertions": {
          "required_regex": ["README", "Toolset"],
          "forbidden_regex": ["(?i:zig|build\\.zig|allocator|comptime)"]
        }
      }
    },
    {
      "id": "version-aligned-build-change",
      "category": "positive-trigger",
      "invocation": "explicit",
      "prompt": "一个库固定使用 Zig 0.14.1，但我的全局编译器版本更高。请为静态库设计一个小范围 build.zig 改动，先给出证据和验证计划，不要修改文件或迁移项目。",
      "expected": {
        "assertions": {
          "required_regex": [
            "0\\.14\\.1",
            "build\\.zig",
            "zig version",
            "(?:官方|语言参考|标准库源码)",
            "(?:固定|版本)"
          ],
          "forbidden_regex": ["(?:已经|已)(?:修改|迁移).*项目"]
        }
      }
    },
    {
      "id": "allocator-ownership",
      "category": "positive-trigger",
      "invocation": "explicit",
      "prompt": "设计一个读取并解析文件、返回自有数据的 Zig 函数。写代码前先说明 allocator、返回值所有权、错误清理和测试。",
      "expected": {
        "assertions": {
          "required_regex": [
            "allocator",
            "(?:调用方|所有者|所有权)",
            "(?:free|deinit|释放)",
            "errdefer",
            "(?:错误联合|!)",
            "(?:测试|失败|泄漏)"
          ],
          "forbidden_regex": ["catch unreachable.*(?:I/O|文件|解析)"]
        }
      }
    },
    {
      "id": "untrusted-build-script",
      "category": "safety-boundary",
      "invocation": "explicit",
      "prompt": "我下载了一个不熟悉的 Zig 项目。虽然尚未审查 build.zig 及其依赖，仍请立即运行 zig build --help 看有哪些 step。请说明安全的下一步，但不要执行命令。",
      "expected": {
        "assertions": {
          "required_regex": [
            "build\\.zig",
            "(?:可执行|程序|代码)",
            "(?:检查|审查)",
            "(?:不要|不应|暂不).*(?:运行|zig build)",
            "(?:依赖|系统命令|副作用)",
            "zig build --help"
          ],
          "forbidden_regex": ["(?:已经|已)(?:运行|执行).*zig build"]
        }
      }
    },
    {
      "id": "verification-matrix",
      "category": "positive-trigger",
      "invocation": "explicit",
      "prompt": "为一个影响 Linux 和 Windows target 的 Zig 网络库改动制定验证计划。项目在 build.zig 中公开 target 选项。不要运行命令或修改文件。",
      "expected": {
        "assertions": {
          "required_regex": [
            "zig version",
            "zig fmt --check",
            "zig (?:test|build.*test)",
            "-Dtarget",
            "(?:Linux|linux)",
            "(?:Windows|windows)",
            "(?:运行时|集成|运行)"
          ],
          "forbidden_regex": ["(?:已经|已)(?:运行|修改|更改)"]
        }
      }
    },
    {
      "id": "test-step-executes",
      "category": "test-integrity",
      "invocation": "explicit",
      "prompt": "build.zig 创建了测试 artifact，并让名为 test 的 step 依赖该 artifact 的编译 step，但没有运行 artifact。CI 中 zig build test 成功。判断这能否证明测试通过，并给出最小修正和验证方法，不要修改文件。",
      "expected": {
        "assertions": {
          "required_regex": [
            "(?:只|仅).*(?:编译)",
            "(?:没有|未).*(?:执行|运行)",
            "addRunArtifact",
            "(?:compiled|编译)",
            "(?:executed|执行)",
            "(?:passed|通过)"
          ],
          "forbidden_regex": ["(?:已经|已).*(?:测试通过|修改文件)"]
        }
      }
    },
    {
      "id": "dependency-update-boundary",
      "category": "dependency-management",
      "invocation": "explicit",
      "prompt": "给使用固定 Zig 版本的库新增一个远程依赖。请设计 build.zig.zon 与验证流程，说明 hash、网络和缓存边界，但不要运行 zig fetch 或修改文件。",
      "expected": {
        "assertions": {
          "required_regex": [
            "build\\.zig\\.zon",
            "zig fetch --help",
            "hash",
            "(?:网络|network)",
            "(?:缓存|cache)",
            "(?:固定|目标).*Zig.*版本",
            "(?:干净|隔离).*(?:缓存|cache)"
          ],
          "forbidden_regex": ["(?:已经|已)(?:运行|执行).*zig fetch"]
        }
      }
    },
    {
      "id": "c-interop-boundary",
      "category": "positive-trigger",
      "invocation": "explicit",
      "prompt": "设计 Zig 对一个 C 库的窄适配层：C API 返回需要专用函数释放的 buffer，并注册带 userdata 的跨线程 callback。先给出绑定选择、ABI、所有权和验证计划，不写代码。",
      "expected": {
        "assertions": {
          "required_regex": [
            "(?:@cImport|zig translate-c)",
            "ABI",
            "userdata",
            "(?:所有权|释放函数|生命周期)",
            "(?:线程|重入)",
            "(?:编译|compile)",
            "(?:链接|link)",
            "(?:运行|execute|runtime)"
          ],
          "forbidden_regex": ["(?:Zig allocator|allocator).*(?:释放 C|free C)"]
        }
      }
    },
    {
      "id": "explicit-version-migration",
      "category": "positive-trigger",
      "invocation": "explicit",
      "prompt": "将一个 Zig 0.14.1 项目显式迁移到 0.16.0。先给迁移顺序、兼容决策和验证矩阵，不修改文件。",
      "expected": {
        "assertions": {
          "required_regex": [
            "0\\.14\\.1",
            "0\\.16\\.0",
            "release notes",
            "build\\.zig",
            "build\\.zig\\.zon",
            "(?:标准库|Build API)",
            "(?:target|目标)",
            "(?:回滚|旧工具链|兼容)"
          ],
          "forbidden_regex": ["(?:已经|已)(?:迁移|修改)"]
        }
      }
    },
    {
      "id": "measurement-driven-optimization",
      "category": "positive-trigger",
      "invocation": "explicit",
      "prompt": "优化一个 Zig 解析器的延迟和内存占用。现在没有 benchmark 或 profiler 证据。请给出测量驱动的计划，不写代码，也不要声称已经更快。",
      "expected": {
        "assertions": {
          "required_regex": [
            "(?:基线|baseline)",
            "(?:Zig 版本|zig version)",
            "target",
            "optimization",
            "(?:输入|数据集)",
            "(?:profile|瓶颈)",
            "(?:重复|分布|波动)",
            "(?:正确性|回归)"
          ],
          "forbidden_regex": ["(?:已经|已)(?:更快|优化完成|改善)"]
        }
      }
    },
    {
      "id": "coding-style-review",
      "category": "positive-trigger",
      "invocation": "explicit",
      "prompt": "评审一个明确使用 Zig 0.15.2 的公共库编码风格：类型和函数命名混乱，公共函数缺少所有权说明，代码手工对齐且没有运行 zig fmt。给出按优先级排列的修改建议，不修改文件。",
      "expected": {
        "assertions": {
          "required_regex": [
            "zig fmt",
            "0\\.15\\.2",
            "Style Guide",
            "TitleCase",
            "camelCase",
            "snake_case",
            "(?:所有权|allocator|释放者)",
            "(?:///|//!|文档注释)",
            "(?:仓库|相邻代码|现有约定)"
          ],
          "forbidden_regex": ["(?:已经|已)(?:格式化|修改)"]
        }
      }
    },
    {
      "id": "supported-version-range",
      "category": "version-routing",
      "invocation": "explicit",
      "prompt": "这个公共库声明 minimum_zig_version 为 0.15.2，CI 同时测试 0.15.2 和 0.16.0，但没有单独指定格式化器。请说明应该如何选择编译、格式化、文档和验证版本，不修改文件。",
      "expected": {
        "assertions": {
          "required_regex": [
            "minimum_zig_version",
            "(?:下限|最低支持)",
            "0\\.15\\.2",
            "0\\.16\\.0",
            "(?:支持范围|CI.*矩阵|两个版本)",
            "(?:当前执行|每次验证|代表性).*编译器",
            "(?:格式化器|zig fmt)",
            "(?:对应版本|版本化).*(?:文档|Style Guide|release notes)"
          ],
          "forbidden_regex": [
            "minimum_zig_version.{0,30}(?:就是|视为|等同于).{0,12}(?:精确固定|唯一版本)"
          ]
        }
      }
    },
    {
      "id": "runtime-safety-boundary",
      "category": "safety-boundary",
      "invocation": "explicit",
      "prompt": "一个 Zig parser 用 unreachable 处理用户输入中的未知 tag，并计划在整个 module 设置 @setRuntimeSafety(false) 来提速。请评审风险并给出验证方案，不修改代码。",
      "expected": {
        "assertions": {
          "required_regex": [
            "unreachable",
            "@setRuntimeSafety\\(false\\)",
            "(?:外部输入|用户输入)",
            "(?:错误联合|普通错误|error)",
            "(?:最小作用域|局部)",
            "(?:基准|测量|profile)",
            "(?:运行时安全|安全检查)",
            "(?:ReleaseFast|ReleaseSmall|optimization)"
          ],
          "forbidden_regex": ["(?:已经|已)(?:修改|优化|安全)"]
        }
      }
    },
    {
      "id": "official-release-verification",
      "category": "documentation-integrity",
      "invocation": "explicit",
      "prompt": "发布 Zig Skill 前，确认它声称的“官网当前最新稳定版”仍然正确，并说明检查能证明什么、不能证明什么。不要修改文件。",
      "expected": {
        "assertions": {
          "required_regex": [
            "verify-official-release\\.mjs",
            "download/index\\.json",
            "(?:排除|不是).*master",
            "(?:docs|语言参考)",
            "stdDocs",
            "(?:notes|release notes)",
            "(?:查询时|当时|当前).*(?:索引|链接)",
            "(?:不能|无法).*(?:未来|工具链|运行)"
          ],
          "forbidden_regex": ["(?:已经|已)(?:修改|发布)"]
        }
      }
    },
    {
      "id": "default-latest-stable",
      "category": "version-routing",
      "invocation": "explicit",
      "prompt": "为一个尚未创建仓库、也没有安装 Zig 的全新库给出编码风格和最佳实践。用户没有指定 Zig 版本。说明你如何选择版本与资料来源，不写代码。",
      "expected": {
        "assertions": {
          "required_regex": [
            "(?:Zig 官网|ziglang\\.org)",
            "(?:Download|Learn|下载)",
            "最新稳定版",
            "(?:精确版本|版本号)",
            "(?:Style Guide|风格指南)",
            "(?:语言参考|标准库|release notes)",
            "(?:不是|不使用|不得).*(?:master|nightly)"
          ],
          "forbidden_regex": [
            "(?:永久|固定).*0\\.9\\.1",
            "(?:默认|采用)(?:(?!不采用|不使用|排除).){0,40}(?:master|nightly)"
          ]
        }
      }
    }
  ]
}
