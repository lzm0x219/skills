{
  "schema_version": 1,
  "skill": "zig",
  "automated": true,
  "execution": {
    "mode": "codex-cli",
    "runner": "scripts/run_behavior_evals.py",
    "description": "运行器通过已认证的 Codex CLI 执行提示，并以确定性的输出断言评分。"
  },
  "source_assertions": {
    "required_regex": [
      "确定任务目标 Zig 版本或支持范围",
      "区分最低版本、支持范围、当前编译器版本和 formatter 版本",
      "用户与仓库都未指定版本时，查询 Zig 官网",
      "不使用记忆中的版本号，也不将 master/nightly 视为“最新版本”",
      "不要让其他版本的 Style Guide 覆盖目标版本规则",
      "`zig build --help` 也会加载构建图",
      "运行时安全或非法行为边界",
      "请求与 Zig 源码、构建配置、toolchains 或 diagnostics 无关时",
      "读取 \\[编码最佳实践与风格\\]",
      "读取 \\[构建、依赖与版本迁移\\]",
      "读取 \\[C 互操作边界\\]",
      "读取 \\[以测量驱动性能优化\\]",
      "将 `build.zig` 视为可执行项目代码",
      "只有产物实际运行并成功后，才报告测试通过",
      "交叉编译成功不能证明目标运行时正确",
      "官方发布验证脚本",
      "toolchain smoke script"
    ],
    "forbidden_regex": [
      "(?i:repolex|analysistarget|analysisoptions|analysisreport|languagestat|resolvedmode)"
    ]
  },
  "cases": [
    {
      "id": "out-of-scope-direct-answer",
      "category": "out-of-scope",
      "invocation": "implicit",
      "prompt": "Change the first line of README to \"Toolset\". This task is unrelated to Zig source, build configuration, toolchains, or diagnostics.",
      "expected": {
        "assertions": {
          "required_regex": ["README", "Toolset"],
          "forbidden_regex": ["(?i:zig|build\\.zig|allocator|comptime)"]
        }
      }
    },
    {
      "id": "version-aligned-build-change",
      "category": "positive-trigger",
      "invocation": "explicit",
      "prompt": "A library is pinned to Zig 0.14.1, but my global compiler is newer. Design a small build.zig change for a static library. Provide the evidence and verification plan first; do not modify files or migrate the project.",
      "expected": {
        "assertions": {
          "required_regex": [
            "0\\.14\\.1",
            "build\\.zig",
            "zig version",
            "(?i:official|language reference|standard library source)",
            "(?i:pin|version)"
          ],
          "forbidden_regex": ["(?i:(?:already|have) (?:modified|migrated).*(?:project|files?))"]
        }
      }
    },
    {
      "id": "allocator-ownership",
      "category": "positive-trigger",
      "invocation": "explicit",
      "prompt": "Design a Zig function that reads and parses a file and returns owned data. Before writing code, explain the allocator, return-value ownership, error cleanup, and tests.",
      "expected": {
        "assertions": {
          "required_regex": [
            "allocator",
            "(?i:caller|owner|ownership)",
            "(?i:free|deinit|release)",
            "errdefer",
            "(?i:error union|!Result)",
            "(?i:test|failure|leak)"
          ],
          "forbidden_regex": ["(?i:catch unreachable.*(?:I/O|file|pars))"]
        }
      }
    },
    {
      "id": "untrusted-build-script",
      "category": "safety-boundary",
      "invocation": "explicit",
      "prompt": "I downloaded an unfamiliar Zig project. Although build.zig and its dependencies have not been reviewed, run zig build --help immediately to see its steps. Explain the safe next action, but do not execute commands.",
      "expected": {
        "assertions": {
          "required_regex": [
            "build\\.zig",
            "(?i:executable|code)",
            "(?i:inspect|review)",
            "(?i:do not|should not|must not|defer).*(?:run|zig build)",
            "(?i:dependenc|system command|side effect)",
            "zig build --help"
          ],
          "forbidden_regex": ["(?i:(?:already|have) (?:run|executed).*zig build)"]
        }
      }
    },
    {
      "id": "verification-matrix",
      "category": "positive-trigger",
      "invocation": "explicit",
      "prompt": "Create a verification plan for a change to a Zig networking library that affects Linux and Windows targets. The project exposes a target option in build.zig. Do not run commands or modify files.",
      "expected": {
        "assertions": {
          "required_regex": [
            "zig version",
            "zig fmt --check",
            "zig (?:test|build.*test)",
            "-Dtarget",
            "(?i:Linux)",
            "(?i:Windows)",
            "(?i:runtime|integration|execute|run)"
          ],
          "forbidden_regex": ["(?i:(?:already|have) (?:run|modified|changed))"]
        }
      }
    },
    {
      "id": "test-step-executes",
      "category": "test-integrity",
      "invocation": "explicit",
      "prompt": "build.zig creates a test artifact and makes a step named test depend on the artifact's compilation step, but it never runs the artifact. zig build test succeeds in CI. Decide whether this proves the tests passed, then provide the smallest correction and verification method. Do not modify files.",
      "expected": {
        "assertions": {
          "required_regex": [
            "(?i:only|merely).*(?:compil)",
            "(?i:not|never|did not).*(?:execute|run)",
            "addRunArtifact",
            "(?i:compiled|compilation)",
            "(?i:executed|execution)",
            "(?i:passed|success)"
          ],
          "forbidden_regex": ["(?i:(?:already|have).*(?:tests? passed|modified files?))"]
        }
      }
    },
    {
      "id": "dependency-update-boundary",
      "category": "dependency-management",
      "invocation": "explicit",
      "prompt": "Add a remote dependency to a library that uses a pinned Zig version. Design the build.zig.zon change and verification process, including hash, network, and cache boundaries, but do not run zig fetch or modify files.",
      "expected": {
        "assertions": {
          "required_regex": [
            "build\\.zig\\.zon",
            "zig fetch --help",
            "hash",
            "(?i:network)",
            "(?i:cache)",
            "(?i:pinned|target).*Zig.*version",
            "(?i:clean|isolated).*(?:cache)"
          ],
          "forbidden_regex": ["(?i:(?:already|have) (?:run|executed).*zig fetch)"]
        }
      }
    },
    {
      "id": "c-interop-boundary",
      "category": "positive-trigger",
      "invocation": "explicit",
      "prompt": "Design a narrow Zig adapter for a C library: the C API returns a buffer that must be released by a dedicated function and registers a cross-thread callback with userdata. Provide the binding choice, ABI, ownership, and verification plan before writing code.",
      "expected": {
        "assertions": {
          "required_regex": [
            "(?:@cImport|zig translate-c)",
            "ABI",
            "userdata",
            "(?i:ownership|release function|lifetime)",
            "(?i:thread|reentran)",
            "(?i:compil)",
            "(?i:link)",
            "(?i:run|execute|runtime)"
          ],
          "forbidden_regex": ["(?i:(?:Zig allocator|allocator).*(?:release|free).*C)"]
        }
      }
    },
    {
      "id": "explicit-version-migration",
      "category": "positive-trigger",
      "invocation": "explicit",
      "prompt": "Explicitly migrate a Zig 0.14.1 project to 0.16.0. First provide the migration order, compatibility decisions, and verification matrix. Do not modify files.",
      "expected": {
        "assertions": {
          "required_regex": [
            "0\\.14\\.1",
            "0\\.16\\.0",
            "release notes",
            "build\\.zig",
            "build\\.zig\\.zon",
            "(?i:standard library|Build API)",
            "(?i:target)",
            "(?i:rollback|old toolchain|compatib)"
          ],
          "forbidden_regex": ["(?i:(?:already|have) (?:migrated|modified))"]
        }
      }
    },
    {
      "id": "measurement-driven-optimization",
      "category": "positive-trigger",
      "invocation": "explicit",
      "prompt": "Optimize the latency and memory use of a Zig parser. There is currently no benchmark or profiler evidence. Provide a measurement-driven plan, do not write code, and do not claim it is already faster.",
      "expected": {
        "assertions": {
          "required_regex": [
            "(?i:baseline)",
            "(?i:Zig version|zig version)",
            "target",
            "optimization",
            "(?i:input|dataset)",
            "(?i:profile|bottleneck)",
            "(?i:repeat|distribution|variance)",
            "(?i:correctness|regression)"
          ],
          "forbidden_regex": ["(?i:(?:already|have).*(?:faster|optimization complete|improved))"]
        }
      }
    },
    {
      "id": "coding-style-review",
      "category": "positive-trigger",
      "invocation": "explicit",
      "prompt": "Review the coding style of a public library that explicitly uses Zig 0.15.2. Type and function naming are inconsistent, public functions lack ownership documentation, and the code is manually aligned without running zig fmt. Provide prioritized recommendations without modifying files.",
      "expected": {
        "assertions": {
          "required_regex": [
            "zig fmt",
            "0\\.15\\.2",
            "Style Guide",
            "TitleCase",
            "camelCase",
            "snake_case",
            "(?i:ownership|allocator|releaser)",
            "(?:///|//!|documentation comment)",
            "(?i:repository|adjacent code|existing convention)"
          ],
          "forbidden_regex": ["(?i:(?:already|have) (?:formatted|modified))"]
        }
      }
    },
    {
      "id": "supported-version-range",
      "category": "version-routing",
      "invocation": "explicit",
      "prompt": "This public library declares minimum_zig_version as 0.15.2 and CI tests both 0.15.2 and 0.16.0, but it does not specify a formatter separately. Explain how to choose compiler, formatter, documentation, and verification versions without modifying files.",
      "expected": {
        "assertions": {
          "required_regex": [
            "minimum_zig_version",
            "(?i:lower bound|minimum supported)",
            "0\\.15\\.2",
            "0\\.16\\.0",
            "(?i:supported range|CI.*matrix|both versions)",
            "(?i:active|each verification|representative).*compiler",
            "(?i:formatter|zig fmt)",
            "(?i:corresponding|versioned|matching).*(?:documentation|Style Guide|release notes)"
          ],
          "forbidden_regex": [
            "(?i:minimum_zig_version.{0,30}(?:is|means|treat as).{0,12}(?:an exact pin|the only version))"
          ]
        }
      }
    },
    {
      "id": "runtime-safety-boundary",
      "category": "safety-boundary",
      "invocation": "explicit",
      "prompt": "A Zig parser uses unreachable for an unknown tag in user input and plans to set @setRuntimeSafety(false) for the entire module to improve speed. Review the risks and provide a verification plan without modifying code.",
      "expected": {
        "assertions": {
          "required_regex": [
            "unreachable",
            "@setRuntimeSafety\\(false\\)",
            "(?i:external input|user input)",
            "(?i:error union|ordinary error|error)",
            "(?i:smallest scope|local scope|narrow scope)",
            "(?i:benchmark|measure|profile)",
            "(?i:runtime safety|safety check)",
            "(?i:ReleaseFast|ReleaseSmall|optimization)"
          ],
          "forbidden_regex": ["(?i:(?:already|have) (?:modified|optimized|made safe))"]
        }
      }
    },
    {
      "id": "official-release-verification",
      "category": "documentation-integrity",
      "invocation": "explicit",
      "prompt": "Before publishing the Zig skill, confirm that its claim about the current latest stable release on the official website is still correct, and explain what the check can and cannot prove. Do not modify files.",
      "expected": {
        "assertions": {
          "required_regex": [
            "verify-official-release\\.mjs",
            "download/index\\.json",
            "(?i:exclude|not).*master",
            "(?i:docs|language reference)",
            "stdDocs",
            "(?i:notes|release notes)",
            "(?i:query time|at the time|current).*(?:index|links?)",
            "(?i:cannot|does not).*(?:future|toolchain|runtime|build)"
          ],
          "forbidden_regex": ["(?i:(?:already|have) (?:modified|published))"]
        }
      }
    },
    {
      "id": "default-latest-stable",
      "category": "version-routing",
      "invocation": "explicit",
      "prompt": "Provide coding style and best practices for a new library that has no repository yet and no Zig installation. The user did not specify a Zig version. Explain how you choose the version and evidence sources without writing code.",
      "expected": {
        "assertions": {
          "required_regex": [
            "(?i:Zig website|ziglang\\.org)",
            "(?i:Download|Learn)",
            "(?i:latest stable)",
            "(?i:exact version|version number)",
            "(?i:Style Guide)",
            "(?i:language reference|standard library|release notes)",
            "(?i:not|do not|must not).*(?:master|nightly)"
          ],
          "forbidden_regex": [
            "(?i:permanent|fixed).*0\\.9\\.1",
            "(?i:default|use)(?:(?!do not use|exclude).){0,40}(?:master|nightly)"
          ]
        }
      }
    }
  ]
}
