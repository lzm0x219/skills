pre-commit:
  piped: true
  jobs:
    - name: partial-stage-guard
      run: .lefthook/partial-stage-guard.sh
    - name: format-staged-go
      run: mise exec -- go run .lefthook/format_staged_go.go
    - name: check-module-metadata
      run: mise run check
    - name: vet-project
      run: mise run lint
