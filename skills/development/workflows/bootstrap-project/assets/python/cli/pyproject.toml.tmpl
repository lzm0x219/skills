[project]
name = "{{PROJECT_NAME}}"
version = "0.1.0"
description = "A minimal Python CLI application"
readme = "README.md"
requires-python = ">={{PYTHON_VERSION}}"
dependencies = []

[project.scripts]
{{PROJECT_NAME}} = "{{MODULE_NAME}}.cli:main"

[dependency-groups]
dev = [
    "build=={{BUILD_VERSION}}",
    "mypy=={{MYPY_VERSION}}",
    "pytest=={{PYTEST_VERSION}}",
    "ruff=={{RUFF_VERSION}}",
]

[build-system]
requires = ["uv_build=={{UV_VERSION}}"]
build-backend = "uv_build"

[tool.ruff]
target-version = "{{RUFF_TARGET}}"

[tool.ruff.lint]
select = ["E4", "E7", "E9", "F", "I", "UP"]

[tool.mypy]
python_version = "{{PYTHON_MAJOR_MINOR}}"
strict = true
files = ["src", "tests"]

[tool.pytest.ini_options]
addopts = "-ra --strict-config --strict-markers"
testpaths = ["tests"]
