#!/usr/bin/env python3

import subprocess

completed = subprocess.run(
    ["git", "diff", "--cached", "--name-only", "--diff-filter=ACMR", "-z"],
    check=False,
    capture_output=True,
)
if completed.returncode != 0:
    raise SystemExit(completed.returncode)

files = [
    path
    for raw in completed.stdout.split(b"\0")
    if raw and (path := raw.decode("utf-8")).endswith((".py", ".pyi"))
]
if not files:
    raise SystemExit(0)

formatted = subprocess.run(
    ["uv", "run", "--locked", "ruff", "format", "--no-cache", *files],
    check=False,
)
if formatted.returncode != 0:
    raise SystemExit(formatted.returncode)

staged = subprocess.run(["git", "add", "--", *files], check=False)
raise SystemExit(staged.returncode)
