#!/bin/sh
set -eu

paths=$(mktemp "${TMPDIR:-/tmp}/bootstrap-staged-rust.XXXXXX")
trap 'rm -f "$paths"' EXIT HUP INT TERM
git diff --cached --name-only --diff-filter=ACMR -z -- '*.rs' > "$paths"

if [ ! -s "$paths" ]; then
  exit 0
fi

xargs -0 rustfmt --edition 2024 -- < "$paths"
xargs -0 git add -- < "$paths"
