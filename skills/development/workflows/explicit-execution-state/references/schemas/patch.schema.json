{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/explicit-execution-state/patch.schema.json",
  "title": "Execution state patch",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["op", "path"],
    "properties": {
      "op": { "enum": ["add", "replace", "remove"] },
      "path": {
        "type": "string",
        "pattern": "^/(confirmed_facts|hypotheses|plan|failed_attempts|blockers|completion_evidence|evidence_refs|artifact_refs)/.+"
      },
      "value": true
    },
    "allOf": [
      {
        "if": { "properties": { "op": { "enum": ["add", "replace"] } } },
        "then": { "required": ["value"] },
        "else": { "not": { "required": ["value"] } }
      }
    ]
  }
}
